# Бэкенд отдаётся на том же домене по пути /api — тогда фронтенд обращается
# к нему по относительному адресу и не нужен CORS.
# Добавьте этот location в server-блок сайта (443) из technolider-site-frontend:

location /api/ {
    proxy_pass         http://127.0.0.1:4000/api/;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    client_max_body_size 20m;   # вложения к заявке (3 × 5 МБ + запас)
}
