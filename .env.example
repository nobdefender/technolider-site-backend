# ── сервер ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
# Домены фронтенда, которым разрешены запросы (через запятую)
CORS_ORIGINS=https://npp-technolider.ru,https://www.npp-technolider.ru

# ── база данных (PostgreSQL) ─────────────────────────────────────────────
# В docker compose база поднимается рядом; хост = имя сервиса db
DATABASE_URL=postgresql://technolider:change-me@db:5432/technolider?schema=public
POSTGRES_USER=technolider
POSTGRES_PASSWORD=change-me
POSTGRES_DB=technolider

# ── защита от спама ──────────────────────────────────────────────────────
# Не более THROTTLE_LIMIT заявок с одного IP за THROTTLE_TTL секунд
THROTTLE_TTL=3600
THROTTLE_LIMIT=5

# Yandex SmartCaptcha: серверный (секретный) ключ. Пусто — проверка отключена
SMARTCAPTCHA_SECRET=

# ── вложения к заявке ────────────────────────────────────────────────────
UPLOADS_DIR=./uploads
UPLOADS_MAX_FILE_MB=5
UPLOADS_MAX_FILES=3

# ── почта (SMTP) ─────────────────────────────────────────────────────────
# Пусто — отправка на почту отключена. Для Яндекс 360: smtp.yandex.ru:465
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Сайт Технолидер <robot@npp-technolider.ru>"
# Кому приходят заявки (через запятую)
MAIL_TO=tehnolidernpp@yandex.ru
MAIL_ATTACH_FILES=true

# ── Telegram ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather и id чата (узнать: @userinfobot или @getmyid_bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_FILES=true
# С российских адресов api.telegram.org недоступен — запросы к боту идут через прокси.
# Поддерживаются socks5://[логин:пароль@]хост:порт и http(s)://[логин:пароль@]хост:порт;
# спецсимволы в пароле кодируются по-URL (@ → %40). Прокси, поднятый на самом сервере
# (вне Docker), доступен изнутри контейнера как socks5://host.docker.internal:1080
TELEGRAM_PROXY_URL=
# Либо вместо прокси — своё зеркало Bot API (nginx на зарубежном сервере или
# self-hosted telegram-bot-api). Без слэша в конце.
TELEGRAM_API_BASE=https://api.telegram.org

# ── служебное ────────────────────────────────────────────────────────────
# Ключ для служебных маршрутов: GET /api/leads, GET /api/health/details и Swagger /api/docs.
# Передаётся заголовком X-Admin-Key или параметром ?key=…; пусто — служебные маршруты недоступны.
# Сгенерировать: openssl rand -hex 24
ADMIN_KEY=
